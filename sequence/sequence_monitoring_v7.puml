@startuml
' Взаимодействие компонентов. Вариант 7.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam sequenceArrowThickness 1
skinparam sequenceParticipantBackgroundColor #F2F7FC
skinparam sequenceParticipantBorderColor #445870
title Диаграмма последовательности — СМО, вариант 7
autonumber

participant "Simulation\nядро" as S
participant "EventCalendar\nкалендарь" as C
participant "MonitoringSource\nисточник" as Src
participant "SelectionDispatcher\nД2П1, Д2Б2" as Sel
participant "PlacementDispatcher\nД1ОЗ2, Д1ОО3" as Pl
database "QueueBuffer\nобщий буфер" as Buf
participant "Worker\nприбор ПЗ2" as W
participant "StatisticsCollector\nстатистика" as Stat

== Инициализация ==
loop Для каждого источника i
    S -> Src : nextInterval()
    Src --> S : dt ~ Exp(λ(i))
    S -> C : schedule(ARRIVAL(i, dt))
end

== Обработка событий ==
loop Пока календарь не пуст
    S -> C : popNext()
    C --> S : e с минимальным временем
    S -> S : t := e.time

    alt e.kind = ARRIVAL
        S -> Src : createRequest(t)
        Src --> S : req
        S -> Stat : onGenerated(req)
        alt generatedCount < N
            S -> Src : nextInterval()
            Src --> S : dt ~ Exp(λ(i))
            S -> C : schedule(ARRIVAL(i, t + dt))
        else generatedCount = N
            S -> C : removeArrivals()
        end

        S -> Sel : firstFreeWorker()
        Sel --> S : worker / none
        alt Есть свободный прибор
            S -> Sel : startIncoming(req, t)
            Sel -> W : start(req, t)
            W --> Sel : finishAt = t + U[a,b]
            Sel -> C : schedule(RELEASE(worker, finishAt))
        else Все приборы заняты
            S -> Pl : enqueueOrReplace(req)
            Pl -> Buf : isFull()
            Buf --> Pl : yes / no
            opt Буфер полон: Д1ОО3
                Pl -> Buf : removeOldest()
                Buf --> Pl : oldReq
                Pl -> Stat : onRejected(oldReq)
            end
            Pl -> Buf : append(req)
            note right of Buf : Д1ОЗ2: добавление в конец
        end

    else e.kind = RELEASE
        S -> W : finish(t)
        W --> S : servedReq
        S -> Stat : onServed(servedReq)
        S -> Sel : startFromQueue(t)
        Sel -> Buf : isEmpty()
        Buf --> Sel : yes / no
        opt В буфере есть заявки
            Sel -> Sel : firstFreeWorker() (Д2П1)
            Sel -> Buf : removeNewest() (Д2Б2: LIFO)
            Buf --> Sel : req
            Sel -> W : start(req, t)
            W --> Sel : finishAt = t + U[a,b]
            Sel -> C : schedule(RELEASE(worker, finishAt))
        end
    end
end

== Завершение ==
S -> Stat : buildResult(t)
Stat --> S : SimulationResult
@enduml
