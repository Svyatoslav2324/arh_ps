@startuml
' Обобщённая блок-схема одной реализации дискретно-событийной модели.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam activityBorderColor #445870
skinparam activityBackgroundColor #F3F7FC
skinparam activityDiamondBackgroundColor #FFF0D5
title Блок-схема моделирования СМО — вариант 7

start
:Считать параметры: n, m, B,
интенсивности λ(i), [a,b], N;
:Инициализировать часы t := 0,
буфер, приборы, счётчики и календарь;
:Запланировать ARRIVAL для каждого источника,
интервалы Exp(λ(i));

while (Календарь не пуст?) is (да)
  :Извлечь ближайшее событие e;
  :t := e.time;
  if (e.kind = ARRIVAL?) then (да)
    :Источник создаёт заявку req;
    :Учитываем генерацию заявки;
    if (Всего сгенерировано меньше N?) then (да)
      :Запланировать следующий ARRIVAL
этого источника через Exp(λ(i));
    else (нет)
      :Удалить прочие будущие ARRIVAL;
      :Оставить ранее запланированные RELEASE;
    endif

    if (Найден свободный прибор?) then (да)
      :Д2П1: выбрать свободный прибор
с минимальным номером;
      :Начать обслуживание req,
длительность U[a,b];
      :Запланировать RELEASE выбранного прибора;
    else (нет)
      if (Буфер заполнен?) then (да)
        :Д1ОО3: вытеснить самую старую
ожидающую заявку;
        :Учесть отказ вытесненной заявке;
      endif
      :Д1ОЗ2: поставить req
в конец общего буфера;
    endif
  else (RELEASE)
    :Завершить обслуживание заявки;
    :Освободить прибор и учесть обслуживание;
    if (Буфер не пуст?) then (да)
      :Д2Б2: извлечь последнюю заявку (LIFO);
      :Д2П1: назначить свободному прибору
с минимальным номером;
      :Начать обслуживание, длительность U[a,b];
      :Запланировать новый RELEASE;
    endif
  endif
  if (Выбран пошаговый режим?) then (да)
    :ОД1: показать время, календарь,
буфер и состояния приборов;
  endif
endwhile (нет)

:ОР1: подсчитать показатели по источникам,
вероятность отказа и загрузку приборов;
:Вывести сводные таблицы;
stop
@enduml
