@startuml flowchart_monitoring_v7
title Обобщённая блок-схема моделирования — мониторинг серверов (вариант 7)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8FBFF
  BorderColor #315A7D
  DiamondBackgroundColor #FFF8E7
  DiamondBorderColor #9B7A32
  ArrowColor #315A7D
}

start
:Считать конфигурацию СМО:
число источников n, приборов m,
ёмкость буфера B, λᵢ, [a, b];
:N := 100; p_prev := не задано; done := false;

repeat
  :Сбросить состояние реализации;
  :Создать источники, приборы,
  буфер, календарь и статистику;
  :Для каждого источника i
  запланировать ARRIVAL через Exp(λᵢ);

  while (Календарь событий не пуст?) is (да)
    :Извлечь событие с минимальным временем;
    :Установить текущее модельное время t;

    if (Событие — ARRIVAL?) then (да)
      :Создать заявку (i, j);
      :Увеличить счётчик generated;
      :ОР1: учесть сгенерированную заявку;
      if (generated < N?) then (да)
        :Запланировать следующий ARRIVAL
        этого источника: t + Exp(λᵢ);
      else (нет)
        :Удалить из календаря будущие ARRIVAL;
        оставить события RELEASE;
      endif

      if (В буфере есть место?) then (да)
        :Д1ОЗ2: добавить заявку
        в конец общей очереди;
      else (нет)
        :Д1ОО3: удалить самую старую
        ожидающую заявку;
        :ОР1: учесть отказ удалённой заявки;
        :Добавить новую заявку
        в конец очереди;
      endif
    else (RELEASE)
      :Освободить прибор;
      :ОР1: зафиксировать завершённое
      обслуживание и время занятости;
    endif

    while (Есть свободный прибор
    и буфер не пуст?) is (да)
      :Д2Б2: выбрать последнюю
      заявку из буфера (LIFO);
      :Д2П1: выбрать первый свободный
      прибор по номеру: П1 → Пm;
      :Удалить заявку из буфера;
      :Начать обслуживание;
      время обслуживания ~ U[a, b];
      :Добавить RELEASE(t + время обслуживания)
      в календарь событий;
    endwhile (нет)

    if (Включён пошаговый режим?) then (да)
      :ОД1: показать календарь событий,
      содержимое буфера и состояние приборов;
    else (нет)
      :Продолжить автоматическое моделирование;
    endif
  endwhile (нет)

  :Вычислить p := число отказов / N;
  if (p_prev задано и
  |p - p_prev| ≤ 0,1 · p_prev?) then (да)
    :Точность достигнута;
    :done := true;
  else (нет)
    :p_prev := p;
    if (p = 0?) then (да)
      :N := 2 · N;
    else (нет)
      :N := ceil(1,643² · (1 - p) / (0,1² · p));
    endif
  endif
repeat while (done = false?) is (да) not (нет)

:ОР1: вывести итоговую таблицу
по источникам и коэффициенты использования приборов;
stop
@enduml
