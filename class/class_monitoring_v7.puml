@startuml
' Вариант 7. Система мониторинга состояния серверов.
' ИБ, ИЗ1, ПЗ2, Д1ОЗ2, Д1ОО3, Д2П1, Д2Б2, ОР1, ОД1.
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members
left to right direction
title Диаграмма классов — имитационная модель СМО, вариант 7

package "Событийная модель" {
  class SimulationConfig {
    + sourceCount: int
    + workerCount: int
    + bufferCapacity: int
    + arrivalRates: double[]
    + serviceMin: double
    + serviceMax: double
    + requestLimit: int
  }

  class Simulation {
    - currentTime: double
    - generatedCount: int
    + initialize(): void
    + step(): bool
    + run(): SimulationResult
    - handleArrival(e: Event): void
    - handleRelease(e: Event): void
  }

  class EventCalendar {
    - events: PriorityQueue<Event>
    + schedule(e: Event): void
    + popNext(): Event
    + removeArrivals(): void
    + isEmpty(): bool
  }

  class Event {
    + time: double
    + kind: EventKind
    + entityId: int
  }
  enum EventKind {
    ARRIVAL
    RELEASE
  }
}

package "Элементы СМО" {
  class MonitoringSource <<ИБ, ИЗ1>> {
    + id: int
    + rate: double
    + nextInterval(): double
    + createRequest(now: double): TelemetryRequest
  }
  class TelemetryRequest {
    + sourceId: int
    + sequenceNumber: int
    + arrivalTime: double
    + startTime: double
    + finishTime: double
    + state: RequestState
  }
  enum RequestState {
    CREATED
    QUEUED
    SERVING
    SERVED
    REJECTED
  }
  class QueueBuffer <<Д1ОЗ2>> {
    - capacity: int
    - requests: Deque<TelemetryRequest>
    + isFull(): bool
    + isEmpty(): bool
    + append(req: TelemetryRequest): void
    + removeOldest(): TelemetryRequest
    + removeNewest(): TelemetryRequest
  }
  class Worker <<ПЗ2>> {
    + id: int
    - currentRequest: TelemetryRequest
    - totalBusyTime: double
    + isFree(): bool
    + start(req: TelemetryRequest, now: double): double
    + finish(now: double): TelemetryRequest
  }
}

package "Диспетчеризация" {
  class PlacementDispatcher <<Д1ОЗ2 / Д1ОО3>> {
    + enqueueOrReplace(req: TelemetryRequest): void
  }
  class SelectionDispatcher <<Д2П1 / Д2Б2>> {
    + firstFreeWorker(): Worker
    + startIncoming(req: TelemetryRequest, now: double): bool
    + startFromQueue(now: double): bool
  }
}

package "Статистика и интерфейс" {
  class StatisticsCollector <<ОР1>> {
    + onGenerated(req: TelemetryRequest): void
    + onRejected(req: TelemetryRequest): void
    + onServed(req: TelemetryRequest): void
    + buildResult(duration: double): SimulationResult
  }
  class SimulationResult {
    + totalGenerated: int
    + totalRejected: int
    + rejectionProbability: double
    + sourceStatistics: SourceStat[]
    + utilizationByWorker: double[]
  }
  class SourceStat {
    + sourceId: int
    + generated: int
    + rejected: int
    + served: int
    + meanWait: double
    + meanService: double
  }
  class StepView <<ОД1>> {
    + show(now: double): void
  }
  class ResultView <<ОР1>> {
    + show(result: SimulationResult): void
  }
}

Simulation --> SimulationConfig
Simulation *-- EventCalendar
Simulation *-- "1..*" MonitoringSource
Simulation *-- "1..*" Worker
Simulation *-- QueueBuffer
Simulation *-- PlacementDispatcher
Simulation *-- SelectionDispatcher
Simulation *-- StatisticsCollector
Simulation --> StepView

EventCalendar o-- "0..*" Event
Event --> EventKind
MonitoringSource ..> TelemetryRequest : создаёт
TelemetryRequest --> RequestState
QueueBuffer o-- "0..*" TelemetryRequest : ожидают
Worker --> "0..1" TelemetryRequest : обслуживает
PlacementDispatcher --> QueueBuffer
PlacementDispatcher --> StatisticsCollector : фиксирует отказ
SelectionDispatcher --> QueueBuffer : LIFO
SelectionDispatcher --> Worker : минимальный ID
SelectionDispatcher --> EventCalendar : планирует RELEASE
StatisticsCollector ..> SimulationResult : формирует
SimulationResult o-- "0..*" SourceStat
ResultView --> SimulationResult

note bottom of QueueBuffer
  Заявки хранятся от старой к новой.
  При переполнении удаляется первая.
  При выборе на обслуживание — последняя.
end note
@enduml
